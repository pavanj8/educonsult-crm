# nginx configuration template for the EduConsult CRM frontend (production SPA).
#
# This file is processed by the nginx:alpine entrypoint's envsubst step
# (see /docker-entrypoint.d/20-envsubst-on-templates.sh), which replaces
# ``${BACKEND_UPSTREAM}`` with the value of the container env var at
# startup. The config is kept intentionally small and explicit so it can
# be reviewed alongside the Dockerfile. The list of API prefixes below
# MUST stay in sync with the dev proxy in frontend/vite.config.ts; if
# you add a new top-level API prefix to the backend, add it here too.
#
# BACKEND_UPSTREAM must be a bare ``host:port`` (no scheme). It is
# resolved lazily at request time via the DNS ``resolver`` below, so
# the upstream hostname does not need to exist at container start
# (which matters for docker-compose where service ordering and DNS
# warm-up are not guaranteed).

# WebSocket upgrade support, used by some backend libraries for
# streaming responses.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Use the host's DNS resolver so that the upstream hostname (which
# typically resolves to a docker-compose service name) is looked up
# per request. The upstream value comes from the container env var.
resolver 127.0.0.11 valid=30s ipv6=off;

server {
    listen 80;
    server_name _;

    # Reasonable defaults for a small SPA.
    client_max_body_size 12m;
    keepalive_timeout 65;

    # Long-cache hashed asset bundles emitted by Vite (e.g.
    # /assets/index-AbCdEf.js). The filename already changes per build,
    # so we can safely cache forever.
    location ~* ^/assets/.*\.(?:js|css|woff2?|ttf|otf|eot|ico|svg|png|jpg|jpeg|gif|webp|map)$ {
        root /usr/share/nginx/html;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The backend API. All prefixes the dev Vite server proxies must be
    # mirrored here so production keeps same-origin requests working
    # (and avoids CORS configuration on the FastAPI side).
    # The variable in ``proxy_pass`` makes nginx resolve
    # $educonsult_backend (defined below) at request time against the
    # DNS ``resolver`` above.
    #
    # The trailing slash is optional (``/?``) so that bare paths like
    # ``/health`` and ``/auth/login`` are also proxied (not just the
    # collection endpoints ``/auth/``).
    location ~ ^/(auth|applications|verifier|notifications|branches|staff|tenants|health)(/|$) {
        set $educonsult_backend http://${BACKEND_UPSTREAM};
        proxy_pass $educonsult_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 60s;
    }

    # Everything else: serve the static bundle, falling back to
    # /index.html so React Router (history mode) keeps working on
    # deep links and full page reloads.
    root /usr/share/nginx/html;
    index index.html;

    # index.html must always be revalidated so deploys are picked up
    # immediately (the asset bundles themselves are immutable).
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }

    location / {
        # Try the exact file, then the directory's index.html, then
        # the SPA shell. This is the standard history-mode fallback.
        try_files $uri $uri/ /index.html;
    }

    # A simple error page for clarity in production logs; the SPA
    # itself handles 404 routing client-side.
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}