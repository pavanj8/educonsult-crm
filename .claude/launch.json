{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "educonsult-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "educonsult-backend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=\"${DATABASE_URL:-sqlite:///./dev.db}\" exec venv/bin/python -m uvicorn app.main:app --port 8000"
      ],
      "cwd": "backend",
      "port": 8000
    }
  ]
}
