# Production env-file template for on-prem Docker Compose.
#
# Usage:  cp infra/.env.prod.example infra/.env.prod
#         $EDITOR infra/.env.prod        # fill in real values; do NOT commit
#
# This file is read by `infra/docker-compose.prod.yml` via --env-file,
# and the same file is referenced (via BACKEND_ENV_FILE below) by the
# `backend` and `migrate` services as their backend-process env. Every
# variable that docker-compose.prod.yml interpolates, plus every
# backend-side variable in ENVIRONMENT.md, must have an entry here.
#
# For the full per-variable reference (defaults, required-for-prod,
# scope) read infra/ENVIRONMENT.md.

# ---- Postgres (consumed by the `postgres` service) ----
POSTGRES_USER=educonsult
POSTGRES_PASSWORD=__SET_ME_long_random__
POSTGRES_DB=educonsult

# ---- MinIO (consumed by `minio`, `minio-init`, and the backend via AWS_* shim) ----
MINIO_ROOT_USER=__SET_ME_minio_user__
MINIO_ROOT_PASSWORD=__SET_ME_minio_password__
MINIO_BUCKET=educonsult-documents
MINIO_REGION=us-east-1

# ---- Image tags the host will pull ----
BACKEND_IMAGE=registry.example.com/educonsult-backend:1.0.0
FRONTEND_IMAGE=registry.example.com/educonsult-frontend:1.0.0

# Path (relative to infra/) to the file holding the backend's own env
# (JWT, SMTP, etc.). Leave as `.env.prod` to reuse this file for both
# compose-level and backend-level config.
BACKEND_ENV_FILE=.env.prod

# Host port mapped to the frontend container's port 80.
FRONTEND_PORT=8080

# ---- Backend process environment ----
# The compose file's `migrate` and `backend` services source these from
# BACKEND_ENV_FILE above. Override every value marked __SET_ME__ before
# running `docker compose up -d`.

# Canonical SQLAlchemy URL; required for production (ENVIRONMENT.md §Database).
DATABASE_URL=postgresql+psycopg://educonsult:__SET_ME_long_random__@postgres:5432/educonsult

# JWT signing key. MUST override the dev default — rotating it invalidates
# every outstanding access + refresh token (Requirements §8).
JWT_SECRET_KEY=__SET_ME_strong_random__

# Outbound transactional email (Requirements §6). Point at the customer's
# real SMTP relay; the dev MailHog defaults are NOT safe for production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com

# Public origin of the frontend, used to build absolute URLs inside email
# bodies (owner-invite, password-reset, etc.). Trailing slashes are stripped.
APP_BASE_URL=https://crm.example.com

# Document storage — MinIO when bundled in the on-prem stack.
DOCUMENT_STORAGE_BUCKET=educonsult-documents
DOCUMENT_STORAGE_ENDPOINT_URL=http://minio:9000
DOCUMENT_STORAGE_REGION=us-east-1

# MinIO also exposes the S3 API, so the backend's boto3 client authenticates
# with AWS_* (set to the same values as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD).
AWS_ACCESS_KEY_ID=__SET_ME_minio_user__
AWS_SECRET_ACCESS_KEY=__SET_ME_minio_password__

# ---- Frontend (nginx) ----
BACKEND_UPSTREAM=backend:8000
# VITE_API_BASE_URL is baked into the SPA bundle at build time, not at
# container start — set it in the frontend image's build args, not here.