# PostgreSQL initialization (used by infra/docker-compose.yml).
# Defaults match backend/app/db/database.py when DATABASE_URL is unset.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=educonsult
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage for documents; used by infra/docker-compose.yml).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=educonsult-documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MailHog (local SMTP capture for email testing; used by infra/docker-compose.yml).
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
