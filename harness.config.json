{
  "project": {
    "name": "EduConsult CRM",
    "repo": "pavanj8/educonsult-crm"
  },
  "backend": {
    "dir": "backend",
    "app_module": "app.main:app",
    "health_path": "/health",
    "requirements": "requirements.txt",
    "lint": "ruff check .",
    "test": "python -m pytest -q"
  },
  "frontend": {
    "dir": "frontend",
    "lint": "npm run lint",
    "build": "npm run build"
  },
  "execution": {
    "mode": "github"
  },
  "queue": {
    "phase": "phase-3"
  },
  "models": {
    "dev": "glm-4.6",
    "verify": "glm-4.6",
    "planner": "glm-4.6"
  },
  "llm": {
    "provider": "zai",
    "providers": {
      "zai": {
        "api": "anthropic",
        "base_url": "https://api.z.ai/api/anthropic",
        "auth_env": "ANTHROPIC_AUTH_TOKEN",
        "auth_scheme": "bearer"
      }
    }
  },
  "protected_paths": ["docs/", "agents/", ".github/", ".cursor/", "scripts/"]
}
